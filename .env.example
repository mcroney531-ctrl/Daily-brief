# --- ProjDash MCP server ---
# Set exactly one of these two.
PROJDASH_MCP_URL=
PROJDASH_MCP_COMMAND=

# --- QuickSum (quicksum-remote) MCP server ---
# "remote" implies a URL, but MCP_COMMAND is supported if it's proxied locally.
QUICKSUM_MCP_URL=
QUICKSUM_MCP_COMMAND=

# --- LinkHoard REST API (the "From the Pool" section) ---
# Left blank, the Pool section is just skipped rather than failing the send.
LINKHOARD_API_URL=
LINKHOARD_API_TOKEN=

# --- Sunday Setup / food planning (the "This Week's Menu" section) ---
# Read directly from Supabase; the publishable key is RLS-scoped and public
# by design. Left blank, the section shows its empty state.
FOOD_SUPABASE_URL=https://fdbkdsracxomwyytfgob.supabase.co
FOOD_SUPABASE_KEY=

# --- Content shaping ---
DAILY_BRIEF_MAX_ITEMS_PER_SECTION=5
DAILY_BRIEF_QUICKSUM_PICKS=2

# --- SMTP (sending) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# --- Email addressing ---
EMAIL_FROM="Daily Briefing <daily-briefing@yourdomain.com>"
EMAIL_TO=mcroney531@gmail.com
EMAIL_SUBJECT_PREFIX=Daily Briefing
