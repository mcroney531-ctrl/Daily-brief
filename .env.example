# --- ProjDash MCP server ---
# Set exactly one of these two.
PROJDASH_MCP_URL=
PROJDASH_MCP_COMMAND=

# --- QuickSum (quicksum-remote) MCP server ---
# "remote" implies a URL, but MCP_COMMAND is supported if it's proxied locally.
QUICKSUM_MCP_URL=
QUICKSUM_MCP_COMMAND=

# --- Content shaping ---
DAILY_BRIEF_MAX_ITEMS_PER_SECTION=5
DAILY_BRIEF_QUICKSUM_PICKS=2

# --- SMTP (sending) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# --- Email addressing ---
EMAIL_FROM="Daily Briefing <daily-briefing@yourdomain.com>"
EMAIL_TO=tnewsome829@gmail.com
EMAIL_SUBJECT_PREFIX=Daily Briefing
